# Ignore video files
*.mp4
# Ignore macOS system files
.DS_Store
# Ignore R project files
.Rproj.user/
# Ignore Microsoft Office temporary lock files
~$*

# Large model / result artefacts from the weather project
ML_Weather_Prediction/*.pkl
ML_Weather_Prediction/*.joblib

# Local Python virtual environment (do not commit installed packages)
.venv/

# Jupyter notebook autosave/checkpoint files
**/.ipynb_checkpoints/

